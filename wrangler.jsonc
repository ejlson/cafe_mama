{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "cafemama",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cafemama"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // `npm run preview:deploy`: a separate Worker, cafemama-preview, on its
    // workers.dev address only, to check a change before it goes live. The
    // top-level Worker above, cafemama, is the live site. Bindings are not
    // inherited by an environment, so they are repeated here.
    "preview": {
      "name": "cafemama-preview",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "cafemama-preview"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
